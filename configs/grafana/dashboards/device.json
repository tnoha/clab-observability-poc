{
  "uid": "network-device",
  "title": "ISP Device Observability",
  "tags": [
    "containerlab",
    "eos",
    "poc"
  ],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Device health",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "title": "Collector stream \u00b7 synchronized / fresh",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(collector_connected{device=\"$device\"})",
          "legendFormat": "{{device}} {{interface}} {{peer}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Last observation \u00b7 age in seconds",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(collector_last_observed_timestamp_seconds{device=\"$device\"})",
          "legendFormat": "{{device}} {{interface}} {{peer}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "BGP neighbor \u00b7 $peer",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 1
      },
      "repeat": "peer"
    },
    {
      "id": 5,
      "title": "Current state \u00b7 $peer",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 6,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(network_bgp_session_up{device=\"$device\",peer=\"$peer\"})",
          "legendFormat": "{{device}} {{interface}} {{peer}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "State history \u00b7 $peer",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 7,
        "w": 18,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (peer) (network_bgp_session_up{device=\"$device\",peer=\"$peer\"})",
          "legendFormat": "{{device}} {{interface}} {{peer}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Latest observations",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "title": "BGP \u00b7 latest CLI and gNMI observations",
      "type": "table",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 9
      },
      "description": "Latest received observation per entity and transport in the selected time range. Check collected_at; CLI runs on demand.",
      "targets": [
        {
          "refId": "A",
          "queryType": "PPL",
          "format": "table",
          "query": "source = `observations-*` | where `device.name` = '$device' | where observation_type = \"bgp_neighbor\" | sort - collected_at | dedup entity_key, `source.transport` | fields `data.peer`, `source.transport`, `data.session_state`, `data.remote_as`, collected_at, deleted"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Interfaces \u00b7 latest CLI and gNMI observations",
      "type": "table",
      "datasource": {
        "type": "grafana-opensearch-datasource",
        "uid": "opensearch"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "description": "Latest received observation per entity and transport in the selected time range. Check collected_at; CLI runs on demand.",
      "targets": [
        {
          "refId": "A",
          "queryType": "PPL",
          "format": "table",
          "query": "source = `observations-*` | where `device.name` = '$device' | where observation_type = \"interface\" | sort - collected_at | dedup entity_key, `source.transport` | fields `data.interface`, `source.transport`, `data.admin_state`, `data.oper_state`, collected_at, deleted"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Interface traffic",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 11,
      "title": "Interface traffic \u00b7 $interface",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(network_interface_in_octets_total{device=\"$device\",interface=\"$interface\"}[1m])) * 8",
          "legendFormat": "RX",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "expr": "max(rate(network_interface_out_octets_total{device=\"$device\",interface=\"$interface\"}[1m])) * 8",
          "legendFormat": "TX",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "repeat": "interface",
      "repeatDirection": "h",
      "maxPerRow": 2
    }
  ],
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(collector_connected, device)",
        "query": {
          "query": "label_values(collector_connected, device)",
          "refId": "variable-device"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "core1",
          "value": "core1"
        },
        "options": []
      },
      {
        "name": "peer",
        "label": "Peer",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(network_bgp_session_up{device=\"$device\"}, peer)",
        "query": {
          "query": "label_values(network_bgp_session_up{device=\"$device\"}, peer)",
          "refId": "variable-peer"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(network_interface_in_octets_total{device=\"$device\"}, interface)",
        "query": {
          "query": "label_values(network_interface_in_octets_total{device=\"$device\"}, interface)",
          "refId": "variable-interface"
        },
        "refresh": 1,
        "sort": 1,
        "hide": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  }
}
